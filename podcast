<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Podcast Episode Player</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent: #8b5cf6;
            --accent-hover: #a78bfa;
        }

        body {
            font-family: system-ui, -apple-system, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }

        .podcast-card {
            background-color: var(--card-bg);
            border-radius: 16px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
            display: flex;
            flex-direction: column;
            max-width: 700px;
            width: 100%;
            overflow: hidden;
            border: 1px solid #334155;
        }

        @media (min-width: 600px) {
            .podcast-card {
                flex-direction: row;
            }
        }

        .podcast-cover {
            position: relative;
            width: 100%;
            background: linear-gradient(135deg, #6366f1, #a855f7);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 200px;
        }

        @media (min-width: 600px) {
            .podcast-cover {
                width: 240px;
                min-height: auto;
            }
        }

        .cover-art-text {
            font-size: 5rem;
            user-select: none;
        }

        .episode-badge {
            position: absolute;
            top: 16px;
            left: 16px;
            background-color: rgba(15, 23, 42, 0.8);
            color: var(--accent-hover);
            padding: 4px 10px;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .podcast-content {
            padding: 24px;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .podcast-header {
            margin-bottom: 16px;
        }

        .podcast-show-title {
            color: var(--accent-hover);
            font-size: 0.875rem;
            font-weight: 600;
            text-transform: uppercase;
            margin: 0 0 8px 0;
        }

        .podcast-episode-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0 0 12px 0;
            line-height: 1.25;
        }

        .podcast-description {
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.5;
            margin: 0;
        }

        .audio-player-container {
            margin-top: 20px;
            margin-bottom: 20px;
        }

        audio {
            width: 100%;
            border-radius: 8px;
        }

        /* Customizes player styling placeholder for WebKit browsers */
        audio::-webkit-media-controls-panel {
            background-color: #334155;
        }

        .podcast-footer {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            border-top: 1px solid #334155;
            padding-top: 16px;
        }

        .meta-info {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .subscribe-links {
            display: flex;
            gap: 8px;
        }

        .btn-subscribe {
            background-color: #334155;
            color: var(--text-main);
            text-decoration: none;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 500;
            transition: background-color 0.2s;
        }

        .btn-subscribe:hover {
            background-color: var(--accent);
        }
    </style>
</head>
<body>

    <div class="podcast-card">
        <!-- Visual Cover Section -->
        <div class="podcast-cover">
            <span class="episode-badge">Ep. 42</span>
            <div class="cover-art-text">🎙️</div>
        </div>
        
        <!-- Text & Player Section -->
        <div class="podcast-content">
            <div class="podcast-header">
                <p class="podcast-show-title">The Tech Horizon Podcast</p>
                <h2 class="podcast-episode-title">Building the Future of the Web with Clean Code</h2>
                <p class="podcast-description">
                    In this episode, we dive deep into modern layouts, semantic elements, and accessible styling tricks to level up your workflow.
                </p>
            </div>

            <!-- Native HTML5 Audio Player Element -->
            <div class="audio-player-container">
                <audio controls preload="metadata">
                    <!-- Replace with your hosted audio file URL (mp3, wav, ogg) -->
                    <source src="https://soundhelix.com" type="audio/mpeg">
                    Your browser does not support the audio element.
                </audio>
            </div>

            <!-- Footer Meta Info and Platforms -->
            <div class="podcast-footer">
                <div class="meta-info">
                    <span>August 19, 2026</span> • <span>45 mins</span>
                </div>
                <div class="subscribe-links">
                    <a href="#" class="btn-subscribe">Spotify</a>
                    <a href="#" class="btn-subscribe">Apple</a>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
